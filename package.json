{
  "name": "toland",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "TOLAND — E-Commerce Storefront + Admin ERP/CRM + WhatsApp Automation",
  "scripts": {
    "build": "pnpm --filter \"@toland/*\" build",
    "dev": "pnpm --filter \"@toland/web\" dev",
    "lint": "pnpm --filter \"@toland/*\" lint",
    "typecheck": "pnpm --filter \"@toland/*\" typecheck",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  },
  "pnpm": {
    "blockExoticSubdeps": false
  },
  "packageManager": "pnpm@12.18.0"
}
